<div class="backdrop"></div>

<form class="filter-form" action="/filtered-index" method="GET">
	<div class="filter-controls">
		<label class="filter-search-label" for="search_term">Name</label>
		<input class="filter-search-input" type="text" name="search_term" id="search_term" value="<%= search_term %>">
		<div class="filter-actions">
			<button class="btn" type="submit" value="accept">Filter</button>
			<button class="btn" type="submit" name="reset" value="1">Reset</button>
		</div>
	</div>

	<fieldset class="filter-flags">
		<legend>Flags</legend>
		<div class="filter-flag-grid">
		<% for(var count = 0; count < flag_list.length; count++) { %>
			<label class="filter-flag">
				<span><%= flag_list[count].flag_abbrev %></span>
				<input type="checkbox" name="flags[]" value="<%= flag_list[count].flag_abbrev %>" <%= flags.includes(flag_list[count].flag_abbrev) ? 'checked' : '' %>>
			</label>
		<% } %>
		</div>
	</fieldset>
</form>

