<%- include('../includes/head.ejs') %>
<link rel="stylesheet" href="/css/main.css">
<link rel="stylesheet" href="/css/model.css">
</head>

	<body>
		<%- include('../includes/navigation.ejs') %>

		<main>
			<section class="content">
				<div class="grid">
					<% for (let photo of photos) { %>
						<% var photo_1; %>
						<% photo_1 = helper.convertFileName(photo.image_name); %>
						<article class="card model-item">
							<div class="photo__small">
								<img src="/images/thumbnail/<%= photo.image_name %>" alt="<%= photo.image_name %>">
							</div>
							<div class="card__actions">
								<a href="/images/<%= photo_1 %>" class="btn"><%= photo_1 %> Images</a>
								<% if(photo.model_id != 0) { %>
									<a href="/model/<%= photo.model_id %>" class="btn">Details</a>
								<% } %>							
							</div>
						</article>
					<% } %>
				</div>
			</section>
		</main>
		<%- include('../includes/end.ejs') %>